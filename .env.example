# ==============================================================================
# APEX-3-MCX SPLIT-FEED HYBRID BROKER CONFIGURATION
# ==============================================================================

# 1. Angel One SmartAPI Credentials (FREE Market Data: Real-Time Quotes, Ticks & Candles)
ANGEL_API_KEY=your_angel_api_key_here
ANGEL_CLIENT_CODE=your_angel_client_code_here
ANGEL_PIN=your_angel_pin_here
ANGEL_TOTP_SECRET=your_angel_totp_secret_here

# === Zerodha Kite Connect Credentials ===
# Obtain from https://developers.kite.trade/
KITE_API_KEY=your_kite_api_key_here
KITE_API_SECRET=your_kite_api_secret_here

# Daily access token — generated each trading day via login flow.
# This must be refreshed before each session.
KITE_ACCESS_TOKEN=your_kite_access_token_here

# 3. Live Trading Safety Gates (MANDATORY: Must all be 'true' for real Zerodha orders)
LIVE_TRADING_ENABLED=false
STATIC_IP_CONFIGURED=false
SEBI_COMPLIANCE_ACKNOWLEDGED=false

# 4. Operating Mode & System Controls
TRADING_MODE=PAPER  # "PAPER" or "LIVE"
LOG_LEVEL=INFO

# 5. Risk & Capital Controls
CAPITAL_RISK_PER_TRADE=0.0125
MAX_MARGIN_UTILIZATION=0.65
DAILY_LOSS_LIMIT_PCT=0.02
MAX_CONSECUTIVE_STOPOUTS=2
DEFAULT_COMMODITY=GOLD
PREFERRED_TIER=MINI

# 6. Macro & Economic Catalyst Engine (Optional)
FINNHUB_API_KEY=

# 7. Operator Dashboard Security (Optional)
DASHBOARD_API_TOKEN=

# 8. Alert Notifications (Optional: Telegram / Email)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_TO=
