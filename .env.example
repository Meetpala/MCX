# 1. Angel One SmartAPI Credentials (FREE Market Data: Real-Time Quotes, Ticks & Candles)
ANGEL_API_KEY=your_angel_api_key_here
ANGEL_CLIENT_CODE=your_angel_client_code_here
ANGEL_PIN=your_angel_pin_here
ANGEL_TOTP_SECRET=your_angel_totp_secret_here

# 2. Zerodha Kite Connect Credentials (ORDER EXECUTION, POSITIONS & MARGINS ONLY)
KITE_API_KEY=your_kite_api_key_here
KITE_ACCESS_TOKEN=your_kite_access_token_here

# Risk & Capital Controls
CAPITAL_RISK_PER_TRADE=0.0125
MAX_MARGIN_UTILIZATION=0.65
DAILY_LOSS_LIMIT_PCT=0.02
MAX_CONSECUTIVE_STOPOUTS=2

# Trading Configuration
DEFAULT_COMMODITY=GOLD
PREFERRED_TIER=MINI
TRADING_MODE=PAPER  # PAPER or LIVE
LOG_LEVEL=INFO
